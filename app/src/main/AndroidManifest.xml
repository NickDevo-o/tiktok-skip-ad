<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Запросы на видимость пакетов TikTok на устройстве (Android 11+) -->
    <queries>
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.zhiliaoapp.musically.go" />
        <package android:name="com.ss.android.ugc.aweme.lite" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_slideshow"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_slideshow"
        android:supportsRtl="true"
        android:theme="@style/Theme.TikTokAdSkipper">

        <!-- Полное отключение аналитики и телеметрии Google ML Kit (Privacy First) -->
        <meta-data
            android:name="firebase_ml_usage_reporting_enabled"
            android:value="false" />
        <meta-data
            android:name="com.google.firebase.ml.vision.DISABLE_USAGE_REPORT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Служба специальных возможностей для распознавания кадров и симуляции перемотки -->
        <service
            android:name=".SkipperAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
